# Port serwera HTTP
PORT=3000

# Ścieżka do pliku bazy SQLite (względem CWD procesu; lokalnie: folder backend/)
DATABASE_PATH=./data/cloud.db

# Bazowy folder na fizyczne pliki użytkowników (storage/data/{userId}/)
STORAGE_ROOT=../storage/data

# Secret key for JWT (zmień na losowy ciąg min. 32 znaki)
JWT_SECRET=wpisz-dlugi-losowy-ciag-min-32-znaki
JWT_EXPIRES_IN=24h

# Origins dozwolone przez CORS (lista po przecinku)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Docker Compose (wolumeny w kontenerze) ---
# DATABASE_PATH=/data/db/cloud.db
# STORAGE_ROOT=/data/storage
# JWT_SECRET ustaw w .env w katalogu prototype/ (patrz .env.example)
