# Port serwera HTTP
PORT=3000

# Ścieżka do pliku bazy SQLite (względem folderu backend/)
DATABASE_PATH=./data/cloud.db

# Bazowy folder na fizyczne pliki użytkowników (storage/data/{userId}/)
STORAGE_ROOT=../storage/data

# Secret key for JWT (zmień na losowy ciąg min. 32 znaki)
JWT_SECRET=wpisz-dlugi-losowy-ciag-min-32-znaki
JWT_EXPIRES_IN=24h
