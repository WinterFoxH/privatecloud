# Zmienne dla Docker Compose (skopiuj do .env w katalogu prototype/)
# NIE commituj prawdziwego .env z produkcyjnym secretem.

# Secret JWT — zmień przed wystawieniem poza localhost
JWT_SECRET=change-me-in-docker-min-32-characters

# TTL tokena access
JWT_EXPIRES_IN=24h

# Port na hoście (nginx → UI + /api)
HOST_PORT=8080

# CORS gdy ktoś woła API poza reverse proxy (dev / debug)
CORS_ORIGINS=http://localhost:8080,http://localhost,http://localhost:5173

# Lokalny Vite (poza Dockerem) — osobny plik .env lub:
# VITE_API_URL=http://localhost:3000
# W obrazie Docker frontend budowany jest z pustym VITE_API_URL (same-origin).
